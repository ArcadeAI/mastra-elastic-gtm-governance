# Copy to .env. Set each section when its workshop module begins.
# These are local defaults and empty credential slots, not deployed resources.
# No test command sends real Slack messages. Live message tests need explicit approval.

# Supplied-input Mastra stage: only model configuration is required.
MODEL_ID=anthropic/claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Arcade module: one attendee-owned gateway and API key.
ARCADE_API_KEY=
ARCADE_GATEWAY_ID=
# CLI-only override for explicit local MCP test servers; web runtime uses the gateway ID.
ARCADE_MCP_URL=
# Copy EXACT observed MCP keys from discovery. Never guess underscore/dot normalization.
ARCADE_ELASTIC_TOOL_NAMES=
ARCADE_DISCOUNT_TOOL_NAME=
ARCADE_GET_OFFER_TOOL_NAME=
# Hook identity is toolkit/name, which is distinct from an MCP client's tool key.
# JSON array of observed {toolkit,name,arguments:[requiredName,optionalName?]} entries.
ARCADE_ELASTIC_HOOK_TOOLS=[]
ARCADE_SALES_TOOLKIT=Sales
ARCADE_IDP_PROVIDER_ID=cg-idp

# Separate secrets. Generate random values; use the same value at each named owner.
# Arcade sends this bearer on /access, /pre, /post. This is NOT an HMAC signature.
ARCADE_HOOK_SECRET=
# Legacy ARCADE_HOOK_SIGNING_SECRET remains accepted as a compatibility alias.
# Lead API and hooks; never an agent tool credential.
LEAD_INTERNAL_TOKEN=
# Hooks and the web host's approval client. Never exposed to the browser/model.
APPROVALS_SERVICE_TOKEN=
# Web server and hooks.
WEB_SERVICE_TOKEN=
# Operator CLI, hooks, web reset and IdP reset; never supplied to agent tools.
WORKSHOP_OPERATOR_TOKEN=

# Elastic module: fixture seeding only. The model uses the Arcade gateway.
ELASTICSEARCH_URL=
ELASTIC_API_KEY=
ELASTIC_GTM_INDEX=gtm-account-context
ELASTIC_MCP_URL=
ELASTIC_MCP_API_KEY=
WORKSHOP_ELASTIC_MODE=owned
WORKSHOP_EVIDENCE_DIR=.workshop/evidence

# Service addresses accept explicit URLs. Hosted addresses must be public HTTPS.
# Hooks service address used by the web host (loopback uses HTTP).
HOOKS_PUBLIC_HOST=localhost:8081
LEAD_APP_PUBLIC_HOST=localhost:8082
IDP_PUBLIC_HOST=http://localhost:8083
WEB_PUBLIC_HOST=localhost:3000
WEB_PUBLIC_ORIGIN=http://localhost:3000

# Persistent files, one owner each. Restart is not reset.
GOVERNANCE_DB_PATH=./governance-renewal.db
LEADS_DB_PATH=./renewal.db
IDP_DB_PATH=./idp.db
MASTRA_DB_URL=file:./mastra-renewal.db

# Demo IdP. Preserve its secret and both OAuth client registrations across resets.
BETTER_AUTH_SECRET=
IDP_PUBLIC_URL=http://localhost:8083
IDP_OAUTH_REDIRECT_URIS=https://cloud.arcade.dev/api/v1/oauth/callback
WORKSHOP_WEB_REDIRECT_URI=http://localhost:3000/auth/callback
# Print the workshop-web client with the IdP's oauth-client command after boot.
WEB_OAUTH_CLIENT_ID=
WEB_OAUTH_CLIENT_SECRET=
# At least 32 characters, random and server-only. Encrypts browser sessions.
WEB_SESSION_SECRET=
WORKSHOP_DEMO_MODE=true

# Dana MUST use your real Arcade project-member email for stock Slack authorization.
# The other roles are distinct seeded identities; no additional inboxes/accounts needed.
PERSONA_DANA_EMAIL=
PERSONA_SAM_EMAIL=sam@example.test
PERSONA_RILEY_EMAIL=riley@example.test
PERSONA_MORGAN_EMAIL=morgan@example.test
# Operator-only identity for actual gateway denial/filter checks before activation.
WORKSHOP_VERIFICATION_USER_ID=verification@example.test

# Thierry supplies the workshop workspace/invite. Join it with your real Slack account.
# Explicit solo mapping sends a DM to auth.test's actual user; Riley still approves.
# Stock Slack scopes: chat:write, im:write, users:read, users:read.email.
# No Slack bot token or public-channel destination is used.
WORKSHOP_SOLO_SLACK=true
# Optional restriction to the workshop Slack team ID.
WORKSHOP_SLACK_TEAM_ID=
