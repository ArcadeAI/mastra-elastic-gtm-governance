# deps
node_modules/
.venv/
__pycache__/

# build
.next/
# `mastra dev` bundles Studio's entry here (#8).
.mastra/
dist/
build/
*.tsbuildinfo

# Next 16 writes these itself (#190). next-env.d.ts differs between `next dev`
# and `next build`, and Next's docs say to ignore it; `next typegen` in the
# root typecheck script regenerates it. AGENTS.md and CLAUDE.md are written by
# `next dev` whenever it detects an AI agent running it. Anchored to the root,
# where the app has lived since #3.
/next-env.d.ts
/AGENTS.md
/CLAUDE.md
# app-test/dev-port.test.ts's throwaway Next project, removed after the run.
/.test-fixtures/

# env — per-worktree ports
.env
.env.local
.env.*.local

# data — bootstrapped from checked-in fixtures, never committed. The -wal and
# -shm sidecars are SQLite's write-ahead log, which holds rows not yet
# checkpointed into the .db: sessions, OAuth clients, audit rows (#19).
# Mastra Studio's memory.db (#36) is covered too: written by Studio, never seeded.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite


# local agent config
.claude/
.mcp.json

# os
.DS_Store

# written by `bun run workshop` from SLACK_NOTICE; shipped in the deploy, never committed
mcp/deal_desk/_config.py
